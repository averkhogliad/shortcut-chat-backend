<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="tx-outbox-001-create-message-outbox" author="tx-outbox">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="message_outbox"/>
            </not>
        </preConditions>
        <createTable tableName="message_outbox">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="topic" type="varchar">
                <constraints nullable="false"/>
            </column>
            <column name="key" type="varchar"/>
            <column name="body" type="jsonb">
                <constraints nullable="false"/>
            </column>
            <column name="headers" type="jsonb">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="published_at" type="timestamptz"/>
            <column name="state" type="varchar">
                <constraints nullable="false"/>
            </column>
            <column name="lease_owner" type="varchar"/>
            <column name="lease_until" type="timestamptz"/>
            <column name="retry_count" type="int" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="next_attempt_at" type="timestamptz"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
